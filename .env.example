# Published Google Form embed URL for the 11-question Giiyo Eats interest form.
# Copy this file to .env.local for local development. On Vercel, set the same
# variable before building. If it is unset, empty, or not a
# https://docs.google.com/forms URL, /join shows "This page is not configured
# yet" and does not render an iframe or an open-form link.
NEXT_PUBLIC_GIIYO_EATS_FORM_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLSe1dsI0Jao2VB3wNTXTkiulzcTiv4bZ79pI8TSiJ0nR6sH7xA/viewform?embedded=true
